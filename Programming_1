def grade(avg):
    if avg >= 90:
        return "A"
    elif avg >= 75:
        return "B"
    elif avg >= 50:
        return "C"
    else:
        return "Fail"


name = input("Enter name: ")
marks = []

for i in range(5):
    m = int(input("Enter marks: "))
    marks.append(m)

total = sum(marks)
avg = total / 5

print("\nName:", name)
print("Total:", total)
print("Average:", avg)
print("Grade:", grade(avg))
